{
	"name": "backend",
	"type": "module",
	"scripts": {
		"dev": "NODE_ENV=dev bun --watch index.js",
		"prod": "NODE_ENV=prod bun index.js",
		"prisma:push:dev": "NODE_ENV=dev bunx prisma db push --schema prisma",
		"prisma:push:prod": "NODE_ENV=prod bunx prisma db push --schema prisma",
		"prisma:generate": "bunx prisma generate --schema prisma",
		"lint": "eslint ."
	},
	"imports": {
		"#constants/*": "./src/constants/*.js",
		"#functions/*": "./src/functions/*.js",
		"#models/*": "./src/models/*.js"
	},
	"dependencies": {
		"@lancedb/lancedb": "^0.26.2",
		"@prisma/client": "^7.4.2",
		"bcrypt": "^5.1.1",
		"chalk": "^5.3.0",
		"dotenv": "^17.3.1",
		"express": "^4.18.2",
		"express-ws": "^5.0.2",
		"pg": "^8.11.3",
		"prisma": "^7.4.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.0.2"
	}
}
